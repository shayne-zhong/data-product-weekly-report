# Required production security settings.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CLOUDBASE_APIKEY=

# Optional dedicated encryption key for stored AI API keys. When empty, ADMIN_SESSION_SECRET is used to derive one.
# Base64-encoded 32-byte key. Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Optional compatibility keys. New keys can be configured directly in /admin.
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
AI_DAILY_LIMIT=30
