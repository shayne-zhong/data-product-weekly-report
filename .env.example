# Required production security settings.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CLOUDBASE_APIKEY=

# WorkBuddy integration for the Data Product Department intranet deployment.
# Generate two different random secrets; do not reuse either token.
WORKBUDDY_OPEN_API_TOKEN=
WORKBUDDY_DEPARTMENT_ID=data-product
WORKBUDDY_OAUTH_RESOLVER_URL=
WORKBUDDY_OAUTH_RESOLVER_TOKEN=
WECOM_OAUTH_CORP_ID=

# Optional one-time directory initialization. Change the batch ID whenever the JSON changes.
# Example: [{"username":"zhongnanhai","wecom_userid":"zhongnanhai"}]
WORKBUDDY_DIRECTORY_MAPPINGS_JSON=
WORKBUDDY_DIRECTORY_BATCH_ID=

# Optional dedicated encryption key for stored AI API keys. When empty, ADMIN_SESSION_SECRET is used to derive one.
# Base64-encoded 32-byte key. Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Optional compatibility keys. New keys can be configured directly in /admin.
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
AI_DAILY_LIMIT=30
